{
  "name": "@knitting-toolkit/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/index.js",
    "start": "NODE_ENV=production node --env-file-if-exists=../.env src/index.js",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=../.env scripts/migrate.js",
    "db:seed": "node --env-file-if-exists=../.env scripts/seed.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "vitest": "^3.0.5"
  }
}
